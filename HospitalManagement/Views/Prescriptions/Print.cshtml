@model HospitalManagement.Models.Prescription

@{
    Layout = null; // No sidebar or navbar for the printable document
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Prescription_RX_@(Model.PrescriptionId)_@(Model.MedicalRecord?.Patient?.FirstName)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        .prescription-pad {
            background-color: #fff;
            max-width: 800px;
            margin: 40px auto;
            padding: 50px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            border-top: 15px solid #0d6efd;
        }

        .rx-symbol {
            font-size: 4rem;
            font-weight: bold;
            color: #0d6efd;
            font-family: serif;
            line-height: 1;
        }

        .hospital-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        /* This hides the print button when the actual PDF is being generated */
        @@media print {
            body {
                background-color: #fff;
            }

            .prescription-pad {
                box-shadow: none;
                margin: 0;
                padding: 20px;
                max-width: 100%;
                border-top: none;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-center mt-4 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm fw-bold me-2">
            <i class="fa-solid fa-download me-2"></i> Download / Print PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg shadow-sm">
            Close Tab
        </button>
    </div>

    <div class="prescription-pad">

        <div class="hospital-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-0">City Care Hospital</h2>
                <p class="text-muted mb-0">123 Health Avenue, Surat, Gujarat</p>
                <p class="text-muted mb-0">Phone: +91 999 888 7777</p>
            </div>
            <div class="text-end">
                <h4 class="fw-bold text-primary mb-0">Dr. @Model.Doctor?.FirstName @Model.Doctor?.LastName</h4>
                <p class="text-muted mb-0">@Model.Doctor?.Specialization</p>
                <p class="text-muted mb-0 small">Reg No: MED-@(Model.Doctor?.DoctorId)889</p>
            </div>
        </div>

        <div class="row mb-4 bg-light p-3 rounded mx-0 border">
            <div class="col-6">
                <p class="mb-1"><strong>Patient Name:</strong> @Model.MedicalRecord?.Patient?.FirstName @Model.MedicalRecord?.Patient?.LastName</p>
                <p class="mb-1"><strong>Patient ID:</strong> #@Model.MedicalRecord?.PatientId</p>
                <p class="mb-0"><strong>Age/Gender:</strong> @(Model.MedicalRecord?.Patient?.DOB.HasValue == true ? (DateTime.Today.Year - Model.MedicalRecord.Patient.DOB.Value.Year).ToString() : "N/A") Yrs / @Model.MedicalRecord?.Patient?.Gender</p>
            </div>
            <div class="col-6 text-end">
                <p class="mb-1"><strong>Date:</strong> @Model.PrescribedDate.ToString("dd MMM yyyy")</p>
                <p class="mb-0"><strong>Prescription ID:</strong> RX-@Model.PrescriptionId</p>
            </div>
        </div>

        <div class="mb-4">
            <span class="rx-symbol">℞</span>
        </div>

        <table class="table table-borderless mb-5">
            <thead class="border-bottom border-dark">
                <tr>
                    <th class="ps-0">Medicine Name</th>
                    <th>Dosage Instructions</th>
                    <th class="text-end pe-0">Duration</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PrescriptionItems != null && Model.PrescriptionItems.Any())
                {
                    foreach (var item in Model.PrescriptionItems)
                    {
                        <tr>
                            <td class="ps-0 fw-bold fs-5">@item.Medicine?.Name</td>
                            <td class="fst-italic text-muted">@item.Dosage</td>
                            <td class="text-end pe-0 fw-bold">@item.DurationDays Days</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">No medications prescribed.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mb-5">
                <h6 class="fw-bold border-bottom pb-2">Doctor's Advice / Diet:</h6>
                <p>@Model.Notes</p>
            </div>
        }

        <div class="row mt-5 pt-5 border-top">
            <div class="col-6">
                <p class="text-muted small mb-0">This is a system generated document.</p>
                <p class="text-muted small">Not valid for medico-legal purposes without physical stamp.</p>
            </div>
            <div class="col-6 text-end">
                <p class="mb-0 border-bottom border-dark d-inline-block px-4 pb-2" style="min-width: 200px;"></p>
                <p class="mt-2 fw-bold">Signature of Physician</p>
            </div>
        </div>

    </div>

    <script>
        window.onload = function() {
            // Optional: Automatically open the print dialog
            // window.print();
        };
    </script>
</body>
</html>