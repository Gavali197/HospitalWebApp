@model HospitalManagement.Models.Prescription
@using HospitalManagement.Auth

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0"><i class="fa-solid fa-file-prescription text-primary me-2"></i>Prescription Document</h3>
                <span class="badge bg-primary fs-6">RX-#@Model.PrescriptionId</span>
            </div>

            <div class="card shadow-sm border-0 border-top border-primary border-4 mb-4">
                <div class="card-body p-4">

                    <div class="row bg-light p-3 rounded mb-4 border mx-0">
                        <div class="col-md-4 border-end">
                            <span class="d-block small text-muted text-uppercase fw-bold">Patient Name</span>
                            <span class="fs-6 fw-bold text-dark">@Model.MedicalRecord?.Patient?.FirstName @Model.MedicalRecord?.Patient?.LastName</span>
                        </div>
                        <div class="col-md-4 border-end">
                            <span class="d-block small text-muted text-uppercase fw-bold">Prescribing Physician</span>
                            <span class="fs-6 fw-bold text-dark">Dr. @Model.Doctor?.FirstName @Model.Doctor?.LastName</span>
                        </div>
                        <div class="col-md-4">
                            <span class="d-block small text-muted text-uppercase fw-bold">Date Issued</span>
                            <span class="fs-6 fw-bold text-primary">@Model.PrescribedDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-4">
                            <h6 class="text-muted fw-bold text-uppercase border-bottom pb-2 mb-2">Clinical Notes & Instructions</h6>
                            <p class="text-dark bg-white border rounded p-3 fst-italic">"@Model.Notes"</p>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-end border-bottom pb-2 mb-3 mt-4">
                        <h6 class="text-muted fw-bold text-uppercase mb-0">Prescribed Medications</h6>

                        @if (User.IsInRole(HospitalRoles.Admin) || User.IsInRole(HospitalRoles.Doctor))
                        {
                            <a asp-controller="PrescriptionItems" asp-action="Create" asp-route-prescriptionId="@Model.PrescriptionId" class="btn btn-sm btn-success fw-bold">
                                <i class="fa-solid fa-plus me-1"></i> Add Medicine
                            </a>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine / Drug Name</th>
                                    <th>Dosage Instructions</th>
                                    <th class="text-center">Duration</th>
                                    @if (User.IsInRole(HospitalRoles.Admin) || User.IsInRole(HospitalRoles.Doctor))
                                    {
                                        <th class="text-end">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PrescriptionItems != null && Model.PrescriptionItems.Any())
                                {
                                    foreach (var item in Model.PrescriptionItems)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">
                                                <i class="fa-solid fa-pills text-muted me-2"></i>@item.Medicine?.Name
                                            </td>
                                            <td>@item.Dosage</td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@item.DurationDays Days</span>
                                            </td>

                                            @if (User.IsInRole(HospitalRoles.Admin) || User.IsInRole(HospitalRoles.Doctor))
                                            {
                                                <td class="text-end">
                                                    <form asp-controller="PrescriptionItems" asp-action="Delete" asp-route-id="@item.ItemId" method="post" style="display:inline;">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this medicine from the prescription?');">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted fst-italic">
                                            No medications have been added to this prescription yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
                <div class="card-footer bg-light py-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Back to Directory</a>

                    <div>
                        <a asp-controller="Prescriptions" asp-action="Print" asp-route-id="@Model.PrescriptionId" target="_blank" class="btn btn-success fw-bold me-2">
                            <i class="fa-solid fa-download me-2"></i>Download PDF
                        </a>

                        @if (Model.MedicalRecord != null)
                        {
                            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.RecordId" class="btn btn-primary fw-bold">
                                <i class="fa-solid fa-notes-medical me-2"></i>Full Record
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>